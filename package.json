{
  "name": "forge-engineering-workbench",
  "version": "3.0.0",
  "private": false,
  "description": "FORGE: the verified engineering harness for AI coding agents — universal installer, Shield security scanner, runtime guard hooks, layered memory, GitHub App and codebase intelligence.",
  "type": "module",
  "bin": {
    "forge": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run --maxWorkers=1 --testTimeout=30000",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mcp": "node dist/mcp/server.js",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "developer-tools",
    "engineering",
    "code-quality",
    "workflows",
    "agent-harness",
    "claude-code",
    "cursor",
    "codex",
    "mcp",
    "security",
    "skills"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "typescript": "^7.0.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "files": [
    "dist",
    "catalog",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ansh44233/FORGE-ECC.git"
  }
}